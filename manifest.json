{
  "manifest_version": 3,
  "name": "Scam Shield - Phishing & Scam Explainer",
  "version": "1.0.0",
  "description": "Paste in a suspicious email, text, or link and get a plain-English breakdown of why it's risky.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["https://scam-shield-backend-mcqp.onrender.com/*"]
}
